package views

import (
	"strings"

	"github.com/lrgalego/htmx-ds/components"
	"github.com/lrgalego/htmx-ds/layout"
	"github.com/lrgalego/htmx-ds/motion"
	"github.com/lrgalego/htmx-ds/theme"

	"github.com/lrgalego/pictura/internal/store"
)

// ShellProps is what every full page needs from the request.
type ShellProps struct {
	Title   string
	User    *store.User
	Fake    bool // the offline provider is in use
	Path    string
	CSS     []string // versioned stylesheet URLs, in order
	Scripts []string // versioned script URLs
	Favicon string
}

// Shell renders the full document: brand head, top bar, content, footer.
// Pictura moves with the Playful profile: springs that overshoot, cards
// that pop in and cascade.
templ Shell(p ShellProps, content templ.Component) {
	@layout.Base(layout.BaseProps{
		Motion:  motion.Playful,
		Title:   p.Title,
		Brand:   "Pictura",
		CSS:     p.CSS,
		Scripts: p.Scripts,
		Head:    head(p),
	}, body(p, content))
}

templ head(p ShellProps) {
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet"/>
	<link rel="icon" href={ p.Favicon } type="image/svg+xml"/>
	<link rel="icon" href="/static/app/icons/favicon-32.png" sizes="32x32" type="image/png"/>
	<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
	<link rel="manifest" href="/manifest.webmanifest"/>
	<meta name="htmx-config" content="{&quot;timeout&quot;:300000}"/>
	<meta name="application-name" content="Pictura"/>
	<meta name="apple-mobile-web-app-title" content="Pictura"/>
	<meta name="mobile-web-app-capable" content="yes"/>
	<meta name="apple-mobile-web-app-capable" content="yes"/>
	<meta name="format-detection" content="telephone=no"/>
	// The browser and status bars take the page's own background. On iOS a
	// dark page runs under a translucent status bar (the top bar pads for
	// it); a light one keeps the default bar, whose text stays dark.
	if theme.IsDark(ctx) {
		<meta name="theme-color" content="#17132b"/>
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
	} else {
		<meta name="theme-color" content="#fff9ef"/>
		<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
	}
}

templ body(p ShellProps, content templ.Component) {
	<div class={ "site", templ.KV("site--tabs", hasTabs(p)), templ.KV("site--immersive", immersive(p)) }>
		@Topbar(p)
		<main class="site__main" data-motion-page>
			@content
		</main>
		@footer()
		if hasTabs(p) {
			@Tabbar(p)
		}
	</div>
}

// immersive pages (the reader) take the whole phone screen: no bars.
func immersive(p ShellProps) bool { return strings.HasSuffix(p.Path, "/read") }

// hasTabs: a signed-in, enabled writer gets the app's tab bar on phones.
func hasTabs(p ShellProps) bool { return p.User != nil && p.User.Enabled && !immersive(p) }

// tabCurrent says which tab the page belongs to.
func tabCurrent(p ShellProps, tab string) bool {
	switch tab {
	case "new":
		return p.Path == "/stories/new"
	case "stories":
		return p.Path == "/stories" || (strings.HasPrefix(p.Path, "/stories/") && p.Path != "/stories/new")
	case "cast":
		return strings.HasPrefix(p.Path, "/cast")
	case "you":
		return strings.HasPrefix(p.Path, "/admin")
	}
	return false
}

func tabAttrs(current bool) templ.Attributes {
	if current {
		return templ.Attributes{"aria-current": "page"}
	}
	return nil
}

// Tabbar is the phone's bottom navigation, the way an app moves between
// its sections. "You" opens the account menu (a bottom sheet on phones).
templ Tabbar(p ShellProps) {
	<nav class="tabbar" aria-label="App">
		<a href="/stories" class="tabbar__tab" { tabAttrs(tabCurrent(p, "stories"))... }>
			<span class="tabbar__icon">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"></path><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"></path></svg>
			</span>
			<span class="tabbar__label">Stories</span>
		</a>
		<a href="/stories/new" class="tabbar__tab tabbar__tab--new" { tabAttrs(tabCurrent(p, "new"))... }>
			<span class="tabbar__icon">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
			</span>
			<span class="tabbar__label">New</span>
		</a>
		<a href="/cast" class="tabbar__tab" { tabAttrs(tabCurrent(p, "cast"))... }>
			<span class="tabbar__icon">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
			</span>
			<span class="tabbar__label">Cast</span>
		</a>
		@components.DropdownTrigger("user-menu", "tabbar__tab", templ.Attributes{"aria-label": "Account", "aria-current": tabCurrentValue(p, "you")}) {
			<span class="tabbar__icon tabbar__icon--avatar">{ initials(p.User.DisplayName) }</span>
			<span class="tabbar__label">You</span>
		}
	</nav>
}

func tabCurrentValue(p ShellProps, tab string) string {
	if tabCurrent(p, tab) {
		return "page"
	}
	return "false"
}

// Logo is the brand mark: a yellow page with a tangerine speech dot.
templ Logo() {
	<svg class="brand__mark" viewBox="0 0 64 64" aria-hidden="true">
		<rect x="4" y="4" width="56" height="56" rx="12" fill="#221b3a"></rect>
		<rect x="12" y="12" width="40" height="40" rx="6" fill="#ffd23f"></rect>
		<path d="M20 22h24M20 32h24M20 42h14" stroke="#221b3a" stroke-width="5" stroke-linecap="round"></path>
		<circle cx="46" cy="44" r="8" fill="#ff7a3d" stroke="#221b3a" stroke-width="4"></circle>
	</svg>
}

templ Topbar(p ShellProps) {
	<header class="topbar">
		<div class="wrap topbar__inner">
			<a href="/" class="brand" aria-label="Pictura home">
				@Logo()
				<span>Pictura</span>
			</a>
			if p.Fake {
				<span class="mode-pill topbar__hide-sm" title="META_API_KEY is not set, so the art is drawn by a placeholder">Placeholder art</span>
			}
			<nav class="topbar__nav" aria-label="Main">
				if p.User != nil {
					if p.User.Enabled {
						@components.LinkButton(components.LinkButtonProps{Href: "/stories", Variant: components.ButtonGhost, Class: "topbar__hide-sm"}) {
							Your stories
						}
						@components.LinkButton(components.LinkButtonProps{Href: "/cast", Variant: components.ButtonGhost, Class: "topbar__hide-sm"}) {
							Your cast
						}
						@components.LinkButton(components.LinkButtonProps{Href: "/stories/new", Class: "topbar__hide-app"}) {
							@components.IconPlus()
							<span class="topbar__hide-sm">New story</span>
						}
					}
					@components.ThemeToggle(components.ThemeToggleProps{})
					@components.DropdownTrigger("user-menu", "btn btn--ghost btn--icon topbar__hide-app", templ.Attributes{"aria-label": "Account menu"}) {
						@components.Avatar(components.AvatarProps{Fallback: initials(p.User.DisplayName), Alt: p.User.DisplayName, Size: "sm"})
					}
					@components.DropdownContent(components.DropdownProps{ID: "user-menu", Align: "end"}) {
						@components.DropdownLabel() {
							{ p.User.DisplayName }
						}
						@components.DropdownSeparator()
						if p.User.Enabled {
							@components.DropdownLink("/stories", templ.Attributes{"class": "menu__hide-app"}) {
								@components.IconFolderOpen()
								Your stories
							}
							@components.DropdownLink("/cast", templ.Attributes{"class": "menu__hide-app"}) {
								@components.IconUser()
								Your cast
							}
							@components.DropdownLink("/stories/new", templ.Attributes{"class": "menu__hide-app"}) {
								@components.IconPlus()
								New story
							}
							if p.User.Admin {
								@components.DropdownLink("/admin", nil) {
									@components.IconSettings()
									Admin
								}
							}
							<div class={ "dropdown__separator", templ.KV("menu__hide-app", !p.User.Admin) } role="separator"></div>
						}
						@components.DropdownItem(templ.Attributes{"hx-post": "/logout", "hx-swap": "none"}) {
							@components.IconLogOut()
							Log out
						}
					}
				} else {
					@components.LinkButton(components.LinkButtonProps{Href: "/login", Variant: components.ButtonGhost}) {
						Log in
					}
					@components.LinkButton(components.LinkButtonProps{Href: "/signup"}) {
						Sign up
					}
				}
			</nav>
		</div>
	</header>
}

templ footer() {
	<footer class="wrap footer">
		<span>Pictura turns scripts into comics.</span>
		<span>Text by Muse Spark, art by Muse Image.</span>
	</footer>
}

// CloseModal empties the modal slot out-of-band, closing any open dialog.
templ CloseModal() {
	<div id="modal-root" hx-swap-oob="innerHTML"></div>
}

templ NotFound() {
	<div class="wrap err-page">
		<h1>Nothing on this page</h1>
		<p class="note">The link is wrong, or the story was deleted.</p>
		<p>
			@components.LinkButton(components.LinkButtonProps{Href: "/stories"}) {
				Back to your stories
			}
		</p>
	</div>
}

templ ServerError(msg string) {
	<div class="wrap err-page">
		<h1>Something broke</h1>
		<p class="note">{ msg }</p>
		<p>
			@components.LinkButton(components.LinkButtonProps{Href: "/stories"}) {
				Back to your stories
			}
		</p>
	</div>
}

// Pending parks an account that is not enabled yet.
templ Pending(u *store.User) {
	<section class="auth">
		<div class="wrap">
			<div class="panel auth__card pending">
				<div class="pending__glyph">🎟️</div>
				<h1>Almost there</h1>
				<p class="auth__lede">{ "Your account is created, " + u.DisplayName + ". It needs to be enabled before you can start a story; you'll be able to log in and go straight to work once it is." }</p>
				<p class="note">Signed in as { u.Username }.</p>
				<div class="form__actions">
					@components.Button(components.ButtonProps{Variant: components.ButtonOutline, Attrs: templ.Attributes{"hx-post": "/logout", "hx-swap": "none"}}) {
						@components.IconLogOut()
						Log out
					}
				</div>
			</div>
		</div>
	</section>
}

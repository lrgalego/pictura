# App-specific targets; the scaffolded Makefile -includes this file.

# Local server reachable from other devices on the network (phone testing).
# The Meta API key is resolved from 1Password for the lifetime of the process
# (see .env.dev.tpl); nothing is written to disk.
dev: generate
	op run --env-file=.env.dev.tpl -- $(GO) run ./cmd/server --host 0.0.0.0 --port $(PORT) --data ./data

# Same, but never touches the Meta API (placeholder art).
dev-fake: generate
	$(GO) run ./cmd/server --host 0.0.0.0 --port $(PORT) --data ./data --fake-ai

# Browser tests (playwright-go, real Chromium): the main flows end to end on
# the offline provider. Self-bootstraps the driver on first run.
test-e2e:
	$(GO) test -tags e2e ./e2e/ -count=1 -timeout 10m $(ARGS)

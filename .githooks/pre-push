#!/bin/sh
# Two guards, one per protected ref:
#
#   main   — only local main is pushed there, from a checkout of it, and the
#            gate (`make gate`) runs first. Work is merged on local main and
#            main is pushed: a branch pushed straight to origin/main
#            (`git push origin HEAD:main`) would leave local main behind and
#            test whatever tree happened to be checked out. Once a commit is
#            on origin/main it is deployable by definition, so it must be
#            green *before* it lands there, not discovered red at release time.
#
#   deploy — refuses anything not already contained in main, local and
#            remote. This holds even if someone commits on deploy with
#            --no-verify, or force-pushes an unrelated branch there. What ships
#            must have passed through main.
#
# git feeds this hook one line per ref being pushed, on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
#
# Bypass with `git push --no-verify` if you genuinely need to.

# Both views of main: local, where releases are merged, and the remote's, which
# is what other machines see and can't be faked by a stale local branch.
local_main=$(git rev-parse --verify --quiet refs/heads/main 2>/dev/null || true)
remote_main=$(git rev-parse --verify --quiet refs/remotes/origin/main 2>/dev/null || true)
if [ -z "$local_main" ] && [ -z "$remote_main" ]; then
	# No main to compare against (fresh clone, or a fork that renamed it).
	# Nothing meaningful to enforce.
	exit 0
fi

status=0
gate_ran=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
	# --- main: tests + coverage before anything lands there ---------------
	if [ "$remote_ref" = "refs/heads/main" ]; then
		# Deleting the branch pushes an all-zero sha; nothing to test.
		case "$local_sha" in
		*[!0]*) ;;
		*) continue ;;
		esac
		short=$(git rev-parse --short "$local_sha" 2>/dev/null || echo "$local_sha")
		if [ "$local_sha" != "$local_main" ]; then
			cat >&2 <<-EOF

			  refusing to push $short to main: it is not your local main.

			  Merge it into local main, then push main itself:

			      git switch main
			      git merge --ff-only <your-branch>
			      git push origin main

			EOF
			status=1
			continue
		fi
		# The gate tests the checked-out tree, so that tree must be main's.
		if [ "$(git rev-parse HEAD 2>/dev/null)" != "$local_sha" ]; then
			cat >&2 <<-EOF

			  refusing to push main from a checkout of something else: the gate
			  tests the checked-out tree, which is not main's.

			      git switch main && git push origin main

			EOF
			status=1
			continue
		fi
		# One run covers every ref in the push.
		[ "$gate_ran" = 1 ] && continue
		gate_ran=1

		if ! command -v go >/dev/null 2>&1; then
			cat >&2 <<-'EOF'

			  pushing to main runs the tests, and `go` is not on PATH.

			  Run the push from the dev shell:

			      nix develop --command git push ...

			  Or bypass with --no-verify if you accept pushing untested code.

			EOF
			status=1
			continue
		fi

		# `make gate` is the whole gate: generated code, build and vet, the
		# tests and coverage floor, then the project's own gate-local checks
		# from Makefile.local. One definition, runnable by hand.
		echo "pre-push: running the gate (make gate) before updating main..." >&2
		if ! make gate >/dev/null 2>&1; then
			printf '\n  refusing to push to main: the gate is red. Run `make gate` to see why.\n\n' >&2
			status=1
		fi
		continue
	fi

	# --- deploy: must be contained in main --------------------------------
	[ "$remote_ref" = "refs/heads/deploy" ] || continue

	# An all-zero local sha means the branch is being deleted; let that through.
	case "$local_sha" in
	*[!0]*) ;;
	*) continue ;;
	esac

	missing=""
	for ref in $local_main $remote_main; do
		git merge-base --is-ancestor "$local_sha" "$ref" || missing=1
	done
	[ -z "$missing" ] && continue

	short=$(git rev-parse --short "$local_sha" 2>/dev/null || echo "$local_sha")
	cat >&2 <<-EOF

	  refusing to push $short to \`deploy\`.

	  It is not on both your local main and origin/main, so this would ship
	  code that never went through main.

	  Get it onto main first:

	      git switch main
	      git merge --ff-only <your-branch>
	      git push origin main

	  Then release with \`shipyard deploy\`.

	EOF
	status=1
done

exit "$status"
